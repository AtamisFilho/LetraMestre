# ─── Database ───────────────────────────────────────────────────────────
# Prisma SQLite. In production use an absolute path on a persistent volume.
DATABASE_URL="file:./dev.db"

# ─── Auth ───────────────────────────────────────────────────────────────
# Secret used to sign admin JWTs (HS256). Generate with:
#   openssl rand -base64 32
# In production, MUST be set and >= 16 chars. If unset in production the
# auth layer fails closed (tokens signed but never verify).
AUTH_SECRET="dev-insecure-secret-change-me-please-16+"

# Bootstrap admin account. Used ONLY to seed the first admin row on first
# login; remove from env after the account exists.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"

# ─── Service-to-service ─────────────────────────────────────────────────
# Shared secret between the web app and the game-server. The game-server
# sends it as the `x-internal-key` header to bypass admin-cookie auth on
# /api/stats, /api/words, /api/game. If unset, the header path is disabled.
INTERNAL_API_KEY="dev-internal-key-change-me"

# Public origin of the web app. Used by the game-server to lock CORS to
# exactly the browser-facing origin (and to allow localhost in dev).
WEB_ORIGIN="http://localhost:3000"

# ─── Game server ────────────────────────────────────────────────────────
# Port the game-server listens on. Caddy reverse-proxies :3003 for browser
# clients via the XTransformPort=3003 allow-list.
GAME_SERVER_PORT="3003"

# URL the game-server uses to call back into the web API (persistence,
# dictionary sync). Override in docker-compose to http://web:3000.
WEB_API_URL="http://localhost:3000"
